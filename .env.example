# ==============================================================================
# Environment Variables Template
# Copy this file to `.env` and fill in your actual credentials.
# NOTE: Do NOT commit `.env` containing sensitive tokens to version control.
# ==============================================================================

# Hugging Face Access Token (Required for gated models like Mistral/Llama or pushing adapters)
HF_TOKEN=your_huggingface_hub_token_here
HUGGING_FACE_HUB_TOKEN=your_huggingface_hub_token_here

# Weights & Biases (Optional if using TensorBoard locally)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=llm-finetuning-pipeline
WANDB_LOG_MODEL=false

# Hardware & Execution Environment
CUDA_VISIBLE_DEVICES=0
TOKENIZERS_PARALLELISM=false
